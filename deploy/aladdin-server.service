[Unit]
Description=aladdin 权限服务端
Documentation=https://github.com/poetlife/aladdin/blob/main/docs/deploy.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aladdin
Group=aladdin
WorkingDirectory=/opt/aladdin

# 配置路径显式写出，不依赖"工作目录下的 config.yml"这个默认位置。
# 默认位置是按启动时的工作目录解析的（见 docs/design/config/server-config.md
# "配置文件的查找"），而工作目录由部署方式决定——显式指定后，
# "我改的那个文件到底有没有被读到"就不再是一个需要猜的问题。
ExecStart=/opt/aladdin/bin/aladdin-server -config /opt/aladdin/config.yml

# 密钥文件。**只有这一行**，所有密钥都放这一个文件：拆成按功能的多份
# 只会多出"重装单元时漏掉一行"的机会，而读它们的是同一个进程、同一个
# uid，分开换不来任何隔离。见 docs/deploy.md 的一次性前置。
#
# 文件里装的是需要保密的那几项：腾讯云 COS 的子账号密钥（ALADDIN_COS_*）、
# GitHub 登录的客户端密钥（ALADDIN_GITHUB_CLIENT_SECRET）。它们不能写进
# config.yml（那个文件会进版本库、进镜像、被贴给别人排查问题），因此放在
# 一个 0600、属主为服务账号的文件里。
#
# **`-` 前缀是有意的**：文件不存在时 systemd 不报错，于是没做那几步的部署
# 照常启动、头像与 GitHub 登录保持未启用。反过来，配了桶地址却没配密钥会在
# 配置校验那一层拒绝启动——那是有意的，不是故障。
EnvironmentFile=-/opt/aladdin/secrets.env

Restart=on-failure
RestartSec=5s

# 日志走标准错误，由 journald 收走。不配 log_file：
# 服务端刻意让"日志写不进去"不升级成"服务不可用"，
# 那就不该在生产环境把日志交给一个可能写不进去的文件。
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aladdin-server

# 内存上限。
#
# 这不是"够用"的估算——服务端常驻只有几十 MB——而是保险丝：一台机器上通常
# 不止这一个服务，而 aladdin 远没有重要到可以让同机的其它服务陪葬。
# 触发上限时进程被内核干掉并由 Restart=on-failure 拉起，影响面有界。
MemoryMax=256M

# 加固：除 /opt/aladdin 外一律只读。
# 产物是 CGO_ENABLED=0 的静态二进制（见 docs/release.md），
# 唯一的写路径就是数据目录，因此这条不需要任何例外。
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/aladdin

[Install]
WantedBy=multi-user.target
