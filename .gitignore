# 构建产物
/bin/
/dist/
coverage.out
coverage.html

# Go
*.test
*.prof

# 前端
web/node_modules/
web/dist/
# 预渲染那一趟的中间产物（SSR 包，见 web/prerender/generate.tsx）
web/dist-prerender/
web/.vite/
web/*.tsbuildinfo
web/node_modules/.vite/
# API 文档页的 Redoc 运行时：由 npm run sync-redoc 从 node_modules 复制（predev/prebuild）
web/public/api-docs/redoc.standalone.js

# SDK（对外发布的 TS 包，见 docs/design/galaxy/sdk.md）
# sdk/src/gen/ **不在此列**：它是 proto 的派生物，与 web/src/gen 一样要进版本库，
# 并由 make check-gen 守着它与 proto 同步。
sdk/node_modules/
sdk/dist/
sdk/*.tsbuildinfo
sdk/node_modules/.vite/
# `npm pack` / 手工发第一次时落在包目录里的 tarball
sdk/*.tgz

# 本地配置与凭证
# config.yml 是团队共享的，可以提交；下面这些是个人本机改动与密钥，不可提交。
.env
.env.local
*.local.yaml
*.local.yml
*.local.json
credentials.json

# 本地数据库（默认 sqlite 落在启动目录，见 docs/design/persistence/）
*.db
*.db-wal
*.db-shm

# agent 指令只认 AGENTS.md：本机若放着 CLAUDE.local.md，Claude Code 会不再读 AGENTS（见 AGENTS.md 顶部）
CLAUDE.local.md

# 编辑器
.idea/
.vscode/
*.swp
.DS_Store
