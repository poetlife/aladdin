{
  "name": "aladdin-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sync-redoc": "cp node_modules/redoc/bundles/redoc.standalone.js public/api-docs/",
    "predev": "npm run sync-redoc",
    "prebuild": "npm run sync-redoc",
    "dev": "vite",
    "build": "tsc -b && vite build && npm run prerender",
    "prerender": "vite build --ssr prerender/generate.tsx --outDir dist-prerender --emptyOutDir && NODE_ENV=production node --disable-warning=ExperimentalWarning dist-prerender/generate.js dist",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "@bufbuild/protobuf": "^2.15.0",
    "@connectrpc/connect": "^2.2.0",
    "@connectrpc/connect-web": "^2.2.0",
    "antd": "^6.6.5",
    "cos-js-sdk-v5": "^1.10.1",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-jsdoc": "^64.5.4",
    "jsdom": "^30.1.1",
    "redoc": "^2.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
